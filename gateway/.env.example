# ── Server ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ── Authentication between Cloudflare and this gateway ──────────────
# 32+ random bytes, hex or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Requests are HMAC-signed; the shared secret never leaves the Worker.
API_SECRET=

# How far apart a request's timestamp and ours may be before the signature
# is rejected. This is the replay window — keep it small.
SIGNATURE_MAX_SKEW_SECONDS=300

# ── Storage ─────────────────────────────────────────────────────────
# Must be a persistent volume. Losing it means scanning the QR again.
SESSION_PATH=/data/whatsapp
DATABASE_PATH=/data/gateway.db

# ── Sending limits. Conservative on purpose. ────────────────────────
MAX_MESSAGES_PER_MINUTE=12
MAX_MESSAGES_PER_SECOND=1
MESSAGE_DELAY_MIN_MS=3000
MESSAGE_DELAY_MAX_MS=9000
QUEUE_CONCURRENCY=1

# ── Retries ─────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BACKOFF_MS=5000,15000,60000

# ── Idempotency ─────────────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400

# ── Retention ───────────────────────────────────────────────────────
# The text of a delivered message is wiped after this many hours; the row
# (id, status, timestamps) survives until the retention below. Keep both
# short — this box is a queue, not a copy of everyone's conversations.
BODY_RETENTION_HOURS=24
MESSAGE_RETENTION_DAYS=30

# ── Phone numbers ───────────────────────────────────────────────────
# Country whose national format (leading 0) is assumed when a number
# arrives without a country code. 972 = Israel.
DEFAULT_COUNTRY_CODE=972

# ── Network ─────────────────────────────────────────────────────────
# Comma-separated. Empty means no browser origin is allowed at all, which
# is the correct setting: only the Cloudflare Worker should call this.
ALLOWED_ORIGINS=
# Comma-separated CIDRs or IPs permitted to reach the API. Empty disables
# the check — rely on HMAC alone. Set it if the host is publicly reachable.
ALLOWED_IPS=
TRUST_PROXY=1
BODY_LIMIT=32kb

# ── Chromium ────────────────────────────────────────────────────────
# Deliberately not set here. Under Docker the path is pinned in
# docker-compose.yml, and a blank line in this file would override it: an empty
# value is still a value, and it sends puppeteer looking for a copy of Chrome
# the image was told never to download. That failure appears only when someone
# presses "connect", long after the container calls itself healthy.
#
# Outside Docker: uncomment and point at a Chromium you installed, or leave it
# absent and let puppeteer fetch its own.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
