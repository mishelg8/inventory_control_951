{
  "name": "tzayad-whatsapp-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp Web gateway for מסייעת 951 — transactional messages only.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -w -p tsconfig.json & node --watch dist/server.js",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.6.3"
  }
}
