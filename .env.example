# Placeholders only. Never put a real value in this file — it is committed,
# and the repository is public.
#
# Two places these actually live:
#
#   locally      .dev.vars, which is gitignored. Same KEY=value format.
#   production   Cloudflare Pages. Identifiers go in wrangler.toml under
#                [vars]; secrets go in with
#                  npx wrangler pages secret put <NAME>
#                and only reach the running Worker on the NEXT deployment.

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────
# Secrets. All three must be set for the integration to do anything, and the
# webhook rejects every event until the app secret is present.
WHATSAPP_ACCESS_TOKEN=replace-with-a-system-user-token
WHATSAPP_VERIFY_TOKEN=replace-with-any-long-random-string
WHATSAPP_APP_SECRET=replace-with-the-app-secret-from-meta

# Identifiers, not secrets. These live in wrangler.toml for production; they
# are repeated here so a local run has everything in one file.
WHATSAPP_PHONE_NUMBER_ID=1216224748249995
WHATSAPP_BUSINESS_ACCOUNT_ID=28252667600994107
META_GRAPH_API_VERSION=v26.0
WHATSAPP_DEFAULT_REGION=IL

# Ceilings for the official channel, so a loop cannot spend a day's budget.
WA_CLOUD_GAP_MS=1000
WA_CLOUD_HOUR_MAX=200
WA_CLOUD_DAY_MAX=1000
WA_CLOUD_MAX_MEDIA_BYTES=4194304
WA_CLOUD_TIMEOUT_MS=20000

# ── The retired GREEN-API gateway ────────────────────────────────────
# Left documented rather than deleted: the code path still exists and comes
# back the moment these three are set. Empty means "not configured", which is
# a supported state — the wa.me buttons keep working.
GREEN_API_URL=
GREEN_ID=
GREEN_TOKEN=
